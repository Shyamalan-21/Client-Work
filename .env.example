# Sri Maruthi Silk Centre - Environment Configuration
# Copy this file to .env.local for local overrides.

# Application URL
NEXT_PUBLIC_SITE_URL=https://srimaruthisilkcentre.com

# Database (Optional - defaults to resilient local JSON store & memory store)
DATABASE_URL=

# Transactional Email Notification (Optional)
# If provided, new enquiries trigger email alerts to the business.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=notifications@srimaruthisilkcentre.com
ENQUIRY_NOTIFICATION_EMAIL=maruthijewellers@gmail.com
